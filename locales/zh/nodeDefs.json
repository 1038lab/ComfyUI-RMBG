  "AILab_FinegrainBoxSegment": {
    "display_name": "Finegrain 框选高清抠图",
    "inputs": {
      "image": {
        "name": "图像",
        "tooltip": "输入图像批次，原生 1024px 高清抠图。"
      },
      "bboxes": {
        "name": "检测框",
        "tooltip": "来自 Florence-2 或 YOLO 目标检测节点的边界框输入。"
      },
      "box_coordinates": {
        "name": "手动坐标框",
        "tooltip": "手动输入的提示边界框，支持像素坐标或归一化坐标 'x1, y1, x2, y2'。"
      },
      "margin": {
        "name": "安全边距",
        "tooltip": "检测框周边的安全预留边距比例。"
      },
      "mask_blur": {
        "name": "遮罩羽化",
        "tooltip": "柔化遮罩边缘半径（0 为禁用）。"
      },
      "mask_offset": {
        "name": "遮罩偏移",
        "tooltip": "以像素为单位向外扩展或向内收缩遮罩边缘。"
      },
      "invert_output": {
        "name": "反转遮罩",
        "tooltip": "反转输出的遮罩。"
      },
      "background": {
        "name": "背景模式",
        "tooltip": "背景类型：Alpha（透明输出）或 Color（填充纯色背景）。"
      },
      "background_color": {
        "name": "背景颜色",
        "tooltip": "选择 Color 背景模式时的十六进制背景颜色。"
      },
      "unload_model": {
        "name": "释放显存",
        "tooltip": "执行完成后立即卸载模型权重以释放显存。"
      }
    },
    "outputs": {
      "0": {
        "name": "图像"
      },
      "1": {
        "name": "遮罩"
      },
      "2": {
        "name": "遮罩预览图"
      }
    }
  },
