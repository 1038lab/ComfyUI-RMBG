{
  "AILab_VRMBG": {
    "display_name": "VRMBG 视频去背",
    "inputs": {
      "images": {
        "name": "连续帧图像",
        "tooltip": "用于时序连续去背景的连续视频帧批次 [B, H, W, C]。"
      },
      "reset_state": {
        "name": "重置时序状态",
        "tooltip": "在当前批次开始时重置时序先验缓存。独立视频段保持开启，分块连续输入时设为关闭。"
      },
      "mask_blur": {
        "name": "遮罩羽化",
        "tooltip": "用于柔化遮罩边缘的高斯模糊半径。"
      },
      "mask_offset": {
        "name": "遮罩偏移",
        "tooltip": "以像素为单位向外扩展（正数）或向内收缩（负数）遮罩边界。"
      },
      "invert_output": {
        "name": "反转遮罩",
        "tooltip": "反转输出的遮罩。"
      },
      "background": {
        "name": "背景模式",
        "tooltip": "输出格式：Alpha 输出透明通道，Color 填充纯色背景。"
      },
      "background_color": {
        "name": "背景颜色",
        "tooltip": "当背景模式设为 Color 时使用的十六进制颜色值。"
      },
      "unload_model": {
        "name": "释放显存",
        "tooltip": "执行完成后立即卸载模型权重以释放显存。"
      }
    },
    "outputs": {
      "0": {
        "name": "图像"
      },
      "1": {
        "name": "遮罩"
      },
      "2": {
        "name": "遮罩预览图"
      }
    }
  },
  "AILab_FeyNoBg": {
